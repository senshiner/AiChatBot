# Server
PORT=3000
NODE_ENV=development

# Clerk (login only — no billing/tiers)
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxx

# Database (optional — chat history is disabled gracefully when empty)
DATABASE_URL=postgresql://user:password@localhost/dbname

# LLM providers — priority first, then round-robin, with automatic failover.
# A provider with a numeric `priority` is tried FIRST on every request
# (lower number = earlier). The rest rotate in round-robin order.
# Leave an API key empty to disable that provider (LLM7 works without a key).

# Provider 0 (priority 1): 9Router milik sendiri — mis. dipublish via ngrok.
# Selama sehat, 100% trafik lewat sini; provider lain jadi fallback otomatis.
# NINEROUTER_BASE_URL / NINEROUTER_BASE_URL_FILE: salah satu wajib diisi untuk mengaktifkan.
# _FILE menunjuk ke file berisi URL (dibaca ulang setiap request — cocok untuk
# URL ngrok yang berubah-ubah: tulis URL baru ke file tanpa restart/ubah kode).
# NINEROUTER_BASE_URL=https://xxxx.ngrok-free.app/v1
# NINEROUTER_BASE_URL_FILE=/path/ke/ninerouter-url.txt
# NINEROUTER_API_KEY=(opsional — "unused" bila 9Router tanpa key)
# NINEROUTER_MODEL=nama-model-di-9router

# Provider 1: Groq (OpenAI-compatible) — free key at https://console.groq.com
GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=openai/gpt-oss-20b

# Provider 2: Gemini (OpenAI-compatible) — free key at https://aistudio.google.com/apikey
# NOTE: create the key under a project with the Gemini API enabled.
# gemini-2.5-flash is retired for new users; gemini-3-flash-preview is verified working.
GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# GEMINI_MODEL=gemini-3-flash-preview

# Provider 3: OpenRouter (OpenAI-compatible) — key at https://openrouter.ai/keys
# Free models use the ":free" suffix. Browse them at https://openrouter.ai/models
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=openai/gpt-oss-120b:free

# Provider 4: Z.AI (OpenAI-compatible) — free key at https://z.ai/manage-apikey/apikey-list
ZAI_API_KEY=
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4
# ZAI_MODEL=glm-4.7-flash

# Provider 5: LLM7 (OpenAI-compatible, anonymous tier works keyless)
# Free token for higher limits at https://dash.llm7.io
# LLM7_API_KEY=
# LLM7_BASE_URL=https://api.llm7.io/v1
# LLM7_MODEL=glm-5.3

# Provider 6: OmegaTech (keyless REST, always enabled)
OMEGATECH_BASE_URL=https://omegatech-api.dixonomega.tech

# Custom providers: ANY other OpenAI-compatible API, no code changes needed.
# Fill NAME + BASE_URL (+ API key + model) and it joins the round-robin pool.
# Slots CUSTOM_1_.._CUSTOM_9_. Optional: _PRIORITY (numeric = tried first every
# request, like 9Router), _TYPE (default "openai-compatible"), _BASE_URL_FILE
# (file containing the URL, re-read per request — for ngrok-style changing URLs).
# Example — xAI Grok:
# CUSTOM_1_NAME=xai
# CUSTOM_1_BASE_URL=https://api.x.ai/v1
# CUSTOM_1_API_KEY=
# CUSTOM_1_MODEL=grok-4-1-fast-non-reasoning
# Example — local Ollama:
# CUSTOM_2_NAME=ollama
# CUSTOM_2_BASE_URL=http://localhost:11434/v1
# CUSTOM_2_API_KEY=ollama
# CUSTOM_2_MODEL=llama3.1:8b

# Frontend URL(s) for CORS — comma-separated if more than one
CLIENT_URL=http://localhost:5173
