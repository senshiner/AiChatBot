# ============================================================
# TEMPLATE ENV FRONTEND — salin file ini menjadi frontend/.env
#   cp .env.example frontend/.env
# lalu isi value aslinya. JANGAN commit frontend/.env ke git.
# ============================================================

# URL backend (tempat Express berjalan).
# Kalau backend & frontend beda device, ganti dengan IP LAN PC,
# mis. http://192.168.1.10:3000 (dan samakan CLIENT_URL di backend/.env)
VITE_API_URL=http://localhost:3000

# Clerk publishable key — ISI KEY ASLI (diawali pk_test_ / pk_live_)
# dari dashboard Clerk tim. Harus sama dengan CLERK_PUBLISHABLE_KEY di backend.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxx
