# URL backend (tempat Express berjalan)
VITE_API_URL=http://localhost:3000

# Clerk publishable key (dashboard Clerk -> API Keys)
# WAJIB diawali pk_test_ atau pk_live_
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxx

# Mode demo: tanpa login Clerk, tanpa backend, tanpa API key.
# Balasan diambil dari bank simpanan lokal (src/lib/demo.js),
# deteksi AI jadi prediksi acak — semua berlabel DEMO di UI.
# Nilai dibaca SAAT BUILD (bukan runtime): set "true" lalu rebuild.
# Deploy Vercel otomatis pakai true via vercel.json.
VITE_DEMO_MODE=false
